# Copy this file to mailcow-calendar-sync.env on your Mailcow host
# and replace the placeholder values if you want environment-based provider setup
# or a fallback bootstrap path for Google / Microsoft credentials.
#
# This file is intended for Mailcow operators, not end users.
# Do not commit the real file with live secrets.

# Always required for encrypting provider access/refresh tokens and
# admin-saved provider client secrets stored by calendar sync.
MC_CALSYNC_CRYPTO_KEY=replace-with-a-long-random-secret-or-base64-32-byte-key

# Optional Google OAuth fallback (server-side Mailcow app registration)
# MC_CALSYNC_GOOGLE_CLIENT_ID=replace-with-google-client-id
# MC_CALSYNC_GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# Optional: override if your callback URL differs from the default path
# MC_CALSYNC_GOOGLE_REDIRECT_URI=https://mail.example.com/api/oauth/google/callback.php
# Optional: override scopes if needed
# MC_CALSYNC_GOOGLE_SCOPES=openid email https://www.googleapis.com/auth/calendar

# Optional Microsoft OAuth fallback (server-side Mailcow app registration)
# MC_CALSYNC_MICROSOFT_CLIENT_ID=replace-with-microsoft-client-id
# MC_CALSYNC_MICROSOFT_CLIENT_SECRET=replace-with-microsoft-client-secret
# Optional: Azure tenant id, defaults to "common"
# MC_CALSYNC_MICROSOFT_TENANT_ID=common
# Optional: override if your callback URL differs from the default path
# MC_CALSYNC_MICROSOFT_REDIRECT_URI=https://mail.example.com/api/oauth/microsoft/callback.php
# Optional: override scopes if needed
# MC_CALSYNC_MICROSOFT_SCOPES=offline_access openid profile email User.Read Calendars.ReadWrite
